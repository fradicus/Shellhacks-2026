{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generated_at", "records"],
  "properties": {
    "schema_version": {"const": "aef-point-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "records": {"type": "array", "maxItems": 500, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["point", "year", "object_url", "object_etag", "index_sha256", "sample_sha256", "crs", "row", "col", "pixel_size_m", "raw", "embedding", "attribution"],
      "properties": {
        "point": {"type": "object", "additionalProperties": false, "required": ["lat", "lon"], "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90}, "lon": {"type": "number", "minimum": -180, "maximum": 180}}},
        "year": {"type": "integer", "minimum": 2017, "maximum": 2100},
        "object_url": {"type": "string", "pattern": "^https://storage\\.googleapis\\.com/alphaearth_foundations/satellite_embedding/v1/annual/[0-9]{4}/"},
        "object_etag": {"type": "string", "minLength": 1},
        "index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sample_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "crs": {"type": "string", "pattern": "^EPSG:32[67][0-9]{2}$"},
        "row": {"type": "integer", "minimum": 0}, "col": {"type": "integer", "minimum": 0},
        "pixel_size_m": {"const": 10},
        "raw": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"type": "integer", "minimum": -127, "maximum": 127}},
        "embedding": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"type": "number", "minimum": -1, "maximum": 1}},
        "attribution": {"const": "The AlphaEarth Foundations Satellite Embedding dataset is produced by Google and Google DeepMind."}
      }
    }}
  }
}

{
  "$id": "https://gridbridge.local/schemas/review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "_id": {
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "record_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "verdict": {
      "type": "string"
    }
  },
  "required": [
    "_id",
    "record_id",
    "verdict",
    "reason",
    "reviewer",
    "at"
  ],
  "title": "An append-only review decision",
  "type": "object"
}

{
  "$id": "https://gridbridge.local/schemas/national-source.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed national source registry entry with actual import state",
  "type": "object", "additionalProperties": true,
  "required": ["_id", "title", "publisher", "authority", "role", "landing_url", "download_url", "publication_date", "vintage", "retrieved_at", "sha256", "public_status", "import_status", "planning_region", "states", "notes"],
  "properties": {
    "_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "authority": {"enum": ["federal_government", "state_government", "regional_planning_organization", "utility", "sponsor_supplied"]},
    "role": {"enum": ["project_plan", "utility_directory", "service_territory_reference", "geography_reference", "planning_directory", "existing_infrastructure_reference"]},
    "landing_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
    "local_reference": {"type": ["string", "null"], "description": "Repository-relative sponsor/source reference when no verified public URL is available"},
    "access_policy": {"enum": ["public_document", "metadata_only", "catalog_only"], "description": "Retain D2 metadata-only handling for a source with a restrictive banner"},
    "download_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
    "publication_date": {"type": ["string", "null"], "description": "Source-published value; never derived from download time"},
    "vintage": {"type": ["string", "null"]},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "public_status": {"enum": ["verified_public", "public_with_banner", "sponsor_supplied", "catalog_only"]},
    "import_status": {"enum": ["imported", "reference_only", "catalogued", "unavailable"]},
    "planning_region": {"type": ["string", "null"]},
    "states": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{2}$"}, "uniqueItems": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"import_status": {"const": "imported"}}}, "then": {"properties": {"public_status": {"enum": ["verified_public", "public_with_banner", "sponsor_supplied"]}, "sha256": {"type": "string"}}, "required": ["access_policy"]}},
    {"if": {"properties": {"landing_url": {"type": "null"}}}, "then": {"required": ["local_reference"], "properties": {"local_reference": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"public_status": {"const": "public_with_banner"}}}, "then": {"required": ["access_policy"], "properties": {"access_policy": {"const": "metadata_only"}}}}
  ]
}

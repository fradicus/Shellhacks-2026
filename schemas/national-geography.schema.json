{
  "$id": "https://gridbridge.local/schemas/national-geography.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived Census reference geography, never project coordinates",
  "type": "object", "additionalProperties": true,
  "required": ["schema_version", "authority", "provenance", "counts", "states", "counties", "regions", "divisions"],
  "properties": {
    "schema_version": {"const": "national-geography-v1"},
    "authority": {"const": "U.S. Census Bureau"},
    "provenance": {"type": "object", "required": ["sources", "notes"]},
    "counts": {"type": "object"},
    "states": {"type": "array", "items": {"$ref": "#/$defs/state"}},
    "counties": {"type": "array", "items": {"$ref": "#/$defs/county"}},
    "regions": {"type": "array", "items": {"type": "object", "required": ["region_code", "name", "bounds"], "properties": {"region_code": {"type": "string", "pattern": "^[1-4]$"}, "name": {"type": "string"}, "bounds": {"$ref": "#/$defs/bounds"}}}},
    "divisions": {"type": "array", "items": {"type": "object", "required": ["division_code", "name", "bounds"], "properties": {"division_code": {"type": "string", "pattern": "^[1-9]$"}, "name": {"type": "string"}, "bounds": {"$ref": "#/$defs/bounds"}}}}
  },
  "$defs": {
    "bounds": {
      "type": ["object", "null"], "required": ["west", "south", "east", "north", "crosses_antimeridian", "fit_west", "fit_east_unwrapped"],
      "properties": {
        "west": {"type": "number", "minimum": -180, "maximum": 180},
        "east": {"type": "number", "minimum": -180, "maximum": 180},
        "south": {"type": "number", "minimum": -90, "maximum": 90},
        "north": {"type": "number", "minimum": -90, "maximum": 90},
        "crosses_antimeridian": {"type": "boolean"},
        "fit_west": {"type": "number"}, "fit_east_unwrapped": {"type": "number"}
      }
    },
    "state": {
      "type": "object", "required": ["state_fips", "usps", "name", "scope", "selectable_primary", "census_region_code", "census_division_code", "bounds"],
      "properties": {
        "state_fips": {"type": "string", "pattern": "^[0-9]{2}$"},
        "usps": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "name": {"type": "string"},
        "scope": {"enum": ["state", "district", "territory"]},
        "selectable_primary": {"type": "boolean"},
        "census_region_code": {"type": ["string", "null"], "pattern": "^[1-4]$"},
        "census_division_code": {"type": ["string", "null"], "pattern": "^[1-9]$"},
        "bounds": {"$ref": "#/$defs/bounds"}
      }
    },
    "county": {
      "type": "object", "required": ["county_geoid", "state_fips", "county_fips", "name", "full_name", "state_usps", "state_name", "scope", "selectable_primary", "bounds"],
      "properties": {
        "county_geoid": {"type": "string", "pattern": "^[0-9]{5}$"},
        "county_fips": {"type": "string", "pattern": "^[0-9]{3}$"},
        "state_fips": {"type": "string", "pattern": "^[0-9]{2}$"},
        "name": {"type": "string"}, "full_name": {"type": "string"},
        "state_usps": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "state_name": {"type": "string"},
        "scope": {"enum": ["state", "district", "territory"]},
        "selectable_primary": {"type": "boolean"},
        "bounds": {"$ref": "#/$defs/bounds"}
      }
    }
  }
}

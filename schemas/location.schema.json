{
  "$id": "https://gridbridge.local/schemas/location.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "if": {
    "properties": {
      "confidence": {
        "not": {
          "const": "rejected"
        }
      }
    }
  },
  "properties": {
    "_id": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "rejected"
      ]
    },
    "endpoint_index": {
      "minimum": 0,
      "type": "integer"
    },
    "evidence": {
      "type": "string"
    },
    "lat": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
    },
    "lon": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "osm_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "osm_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "description": "<project_key>@<source_id>: the filing version this evidence belongs to (#47). Without it (and source_id) the loader binds to the key's only active version.",
      "type": "string"
    },
    "project_key": {
      "type": "string"
    },
    "source_id": {
      "description": "The filing (source _id) the evidence was produced for",
      "type": "string"
    }
  },
  "required": [
    "project_key",
    "endpoint_index",
    "name",
    "confidence",
    "evidence"
  ],
  "then": {
    "required": [
      "lat",
      "lon"
    ]
  },
  "title": "One endpoint location (or rejected candidate) with evidence",
  "type": "object"
}

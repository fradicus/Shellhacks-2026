# Placeholders only. Real values live in GitHub secrets, Vercel env or the lane machine's shell (specs/tech-stack.md).

# Lane A machine only (pipeline Gemini stages)
GEMINI_API_KEY=
GEMINI_MODEL=

# GitHub Actions secret only (the `load` workflow is the only Atlas writer)
MONGODB_URI_RW=

# Vercel env + lane B/C machines (read-only user)
MONGODB_URI_RO=
MONGODB_DB=gridbridge

# CI and local dev without Atlas. Never set in production.
DATA_MODE=fixture

# Future vs historical split (default: run_start date)
ANALYSIS_DATE=2026-09-26

# Optional: absolute base URL for server-side calls to this app's /api routes (defaults to the Vercel URL or localhost)
SITE_URL=

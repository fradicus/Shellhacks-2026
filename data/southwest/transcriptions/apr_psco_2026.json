   "native_id": "colorados-power-pathway",
   "name": "Colorado’s Power Pathway",
   "page": 1,
   "quote": "1. Colorado’s Power Pathway Colorado’s Power Pathway (CPP) is a major transmission project proposed by PSCo to improve the state’s electric grid and enable renewable energy development around the state. The project is estimated to consist of approximately 560 to 650 miles of new double circuit 345 kV lines (with optional radial extension into southeast Colorado)",
   "owner": "Public Service Company of Colorado",
   "states": [
    "CO"
   ],
   "state_basis": "text",
   "kind": null,
   "facilities": [],

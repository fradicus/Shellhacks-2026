{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridbridge.local/schemas/verified-domain-record-v1.json",
  "title": "Strict F33 normalized record",
  "oneOf": [
    {"$ref": "#/$defs/source"},
    {"$ref": "#/$defs/utility"},
    {"$ref": "#/$defs/activity"},
    {"$ref": "#/$defs/territory"},
    {"$ref": "#/$defs/assertion"},
    {"$ref": "#/$defs/quarantine"}
  ],
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["accepted", "needs_review", "rejected", "unresolved", "conflicting"]},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_sha256", "member", "member_sha256", "sheet", "row", "raw"],
      "properties": {
        "source_id": {"const": "eia-861-2024-final"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "member": {"enum": ["Frame_2024.xlsx", "Utility_Data_2024.xlsx", "Service_Territory_2024.xlsx"]},
        "member_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sheet": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 1},
        "raw": {"type": "object"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "publisher", "title", "vintage", "retrieved_at", "landing_url", "content_sha256", "upstream_lineage", "role", "limitations"],
      "properties": {
        "id": {"enum": ["eia-861-2024-final", "census-geography-reference"]},
        "publisher": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "vintage": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "format": "date-time"},
        "landing_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "download_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "member_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "digest_semantics": {"type": "string", "minLength": 1},
        "upstream_lineage": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/stringArray"}
      }
    },
    "utility": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "eia_utility_id", "data_year", "name", "short_form", "ownership_code", "ownership", "filing_flags", "state_fips", "county_geoids", "source_ids", "validation_status", "limitations", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^eia861-2024-utility-"}, "eia_utility_id": {"type": "string", "pattern": "^[0-9]+$"},
        "data_year": {"const": 2024}, "name": {"type": "string", "minLength": 1},
        "short_form": {"$ref": "#/$defs/nullableString"}, "ownership_code": {"$ref": "#/$defs/nullableString"},
        "ownership": {"$ref": "#/$defs/nullableString"}, "filing_flags": {"type": "object"},
        "state_fips": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{2}$"}, "uniqueItems": true},
        "county_geoids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{5}$"}, "uniqueItems": true},
        "source_ids": {"$ref": "#/$defs/stringArray"}, "validation_status": {"enum": ["accepted", "needs_review", "rejected"]},
        "limitations": {"$ref": "#/$defs/stringArray"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "eia_utility_id", "data_year", "name", "state_raw", "state_fips", "ownership", "nerc_region", "nerc_flags", "rto_flags", "activities", "validation_status", "limitations", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^eia861-2024-activity-"}, "eia_utility_id": {"type": "string", "pattern": "^[0-9]+$"},
        "data_year": {"const": 2024}, "name": {"type": "string", "minLength": 1}, "state_raw": {"$ref": "#/$defs/nullableString"},
        "state_fips": {"type": ["string", "null"], "pattern": "^[0-9]{2}$"}, "ownership": {"$ref": "#/$defs/nullableString"},
        "nerc_region": {"$ref": "#/$defs/nullableString"}, "nerc_flags": {"type": "object"}, "rto_flags": {"type": "object"},
        "activities": {"type": "object"}, "validation_status": {"enum": ["accepted", "rejected"]},
        "limitations": {"$ref": "#/$defs/stringArray"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "territory": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "eia_utility_id", "data_year", "name", "short_form", "state_raw", "county_raw", "state_fips", "county_geoid", "candidate_geoids", "identity_match_method", "validation_status", "exclusive", "project_location", "source_ids", "limitations", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^eia861-2024-territory-"}, "eia_utility_id": {"type": "string", "pattern": "^[0-9]+$"},
        "data_year": {"const": 2024}, "name": {"type": "string", "minLength": 1}, "short_form": {"$ref": "#/$defs/nullableString"},
        "state_raw": {"$ref": "#/$defs/nullableString"}, "county_raw": {"$ref": "#/$defs/nullableString"},
        "state_fips": {"type": ["string", "null"], "pattern": "^[0-9]{2}$"},
        "county_geoid": {"type": ["string", "null"], "pattern": "^[0-9]{5}$"},
        "candidate_geoids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{5}$"}, "uniqueItems": true},
        "identity_match_method": {"enum": ["census_name_exact", "census_name_alias", null]},
        "validation_status": {"enum": ["accepted", "unresolved", "conflicting", "rejected"]},
        "exclusive": {"const": false}, "project_location": {"const": false}, "source_ids": {"$ref": "#/$defs/stringArray"},
        "limitations": {"$ref": "#/$defs/stringArray"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "predicate", "object", "claim_source_id", "identity_reference_source_id", "upstream_lineages", "independent_lineage_count", "independently_corroborated", "validation_status", "limitations", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^assertion-eia861-2024-territory-"}, "subject": {"type": "object"},
        "predicate": {"const": "distribution_equipment_present_in_county"}, "object": {"type": "object"},
        "claim_source_id": {"const": "eia-861-2024-final"}, "identity_reference_source_id": {"const": "census-geography-reference"},
        "upstream_lineages": {"const": ["eia-861-2024-final"]}, "independent_lineage_count": {"const": 1},
        "independently_corroborated": {"const": false}, "validation_status": {"$ref": "#/$defs/status"},
        "limitations": {"$ref": "#/$defs/stringArray"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "record_type", "record_id", "reason", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^quarantine-"}, "record_type": {"enum": ["utility_activity", "service_territory"]},
        "record_id": {"type": "string", "minLength": 1},
        "reason": {"enum": ["unknown_utility_number", "comparable_field_conflict", "unresolved_county_identity", "ambiguous_county_identity"]},
        "candidate_geoids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{5}$"}, "uniqueItems": true},
        "conflicting_fields": {"type": "array", "items": {"enum": ["name", "ownership"]}, "uniqueItems": true},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
